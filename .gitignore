# MindDuet Scholar now keeps code and personal study notes in one repository.
# Ignore generated local state, caches, credentials, and machine-specific config.

# Local application state and Python tooling
.mindduet/
.venv/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
__pycache__/
*.py[cod]
*.sqlite3
*.log

# LaTeX build products
*.aux
*.dvi
*.bbl
*.bcf
*.blg
*.fls
*.fdb_latexmk
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.xdv

# Local editor and agent state
.vscode/
.claude/
.auto-git-on-exit
tools/auto-git-on-exit/
**/.obsidian/workspace*.json

# Local credentials
APIKEY
DeepSeekAPI
.env
.env.*
.aider*

# Windows alternate data stream files left by cross-filesystem copies.
*:Zone.Identifier
*_Zone.Identifier

# Local compiled thesis binaries
研究论文/CTRW/Canard/canard_vdp

# Local study assets. They remain inside the project for indexing and reading,
# while Git keeps only notes, source code, and the small tracked inventories.
/英语学习/
/数学教材/**/*.pdf
/数学教材/**/*.epub
/数学教材/**/*.mobi
/数学教材/**/*.djvu
/数学教材/**/*.azw*
/数学教材/**/*.doc
/数学教材/**/*.docx
/数学教材/**/*.mht
/数学教材/**/*.zip
/数学教材/**/*.xlsx
